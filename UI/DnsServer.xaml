<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource PageScroll}">
    <StackPanel Margin="40,32,40,28" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="DNS" Style="{DynamicResource PageTitle}"/>
        <TextBlock Style="{DynamicResource Subtitle}" Text="DNS-Logging prüfen, einschalten und die Logs mit Metadaten in den Tauschordner legen. Ausgewertet wird im Berater-Tool."/>

        <Border Style="{DynamicResource CardBox}" Margin="0,20,0,0" Background="{DynamicResource Card}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Status" Style="{DynamicResource CardTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnDnsRefresh" Content="Status lesen" Tag="&#xE72C;" Style="{DynamicResource PrimaryButton}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtDnsState" Text="Noch nicht gelesen" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="TxtDnsDetail" Style="{DynamicResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border x:Name="BoxDnsEnable" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Logs sammeln" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,10" TextWrapping="Wrap" Text="Das Logging ist aus. Es wird mit Queries, Answers, Send, Receive, UDP, TCP sowie Notify und Update eingeschaltet. Vor der Änderung folgen eine Prüfung und eine Bestätigung."/>
                <TextBlock Text="Pfad der Logdatei" Style="{DynamicResource FieldLabel}"/>
                <TextBox x:Name="TxtDnsPath" Padding="8,6" Margin="0,4,0,10" AutomationProperties.Name="Pfad der DNS-Logdatei"/>
                <TextBlock Text="Maximale Größe in MB" Style="{DynamicResource FieldLabel}"/>
                <TextBox x:Name="TxtDnsMax" Padding="8,6" Margin="0,4,0,12" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Maximale Größe der Logdatei in MB"/>
                <Button x:Name="BtnDnsEnable" Content="Logging einschalten …" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <Border x:Name="BoxDnsOn" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Logging ausschalten" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,10" TextWrapping="Wrap" Text="Stellt den gesicherten Zustand von vor dem Einschalten wieder her. Die Logdatei bleibt erhalten."/>
                <Button x:Name="BtnDnsDisable" Content="Logging ausschalten …" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <Border x:Name="BoxDnsLogs" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Logs in den Tauschordner" Style="{DynamicResource CardTitle}"/>
                <TextBlock x:Name="TxtDnsLogInfo" Style="{DynamicResource Hint}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,10" TextWrapping="Wrap" Text="Packt die Logdatei (auch wenn der DNS-Dienst sie offen hält) mit einer Metadatei (Servername, Zeitzone, Datumsformat, eigene IPs, Forwarder, Sekundärserver, Domänencontroller, Zonen) und lädt das ZIP in Teilen hoch."/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnDnsUpload" Content="Logs hochladen" Tag="&#xE898;" Style="{DynamicResource PrimaryButton}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtDnsProgress" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"/>
                </StackPanel>
                <ProgressBar x:Name="PrgDns" Style="{DynamicResource ThinProgress}" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </StackPanel>
</ScrollViewer>
