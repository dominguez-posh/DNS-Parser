<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource PageScroll}">
    <!-- Startseite des Server-Fensters: gefuehrter Ablauf. Logik: server\SmAssistent.ps1. Keine Symbolzeichen in diesem Teil. -->
    <StackPanel Margin="40,32,40,28" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="Dieser Server" Style="{DynamicResource PageTitle}"/>
        <TextBlock x:Name="TxtServer" Style="{DynamicResource Subtitle}"/>
        <Border x:Name="BoxAdmin" Style="{DynamicResource WarnBand}" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Style="{DynamicResource BandText}" Text="Dieses Fenster läuft nicht als Administrator. Für Änderungen bitte PowerShell mit 'Als Administrator ausführen' öffnen und den Einzeiler erneut einfügen."/>
        </Border>

        <Border Style="{DynamicResource CardBox}" Margin="0,20,0,0" Background="{DynamicResource Card}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Tauschordner" Style="{DynamicResource CardTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnRefresh" Content="Ordner prüfen" Style="{DynamicResource PrimaryButton}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtShareState" Text="Kein Tauschordner (nur lokal)" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"/>
                </StackPanel>
                <TextBox x:Name="TxtFiles" Style="{DynamicResource CodeBox}" Margin="0,10,0,0" MaxHeight="140" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Ablauf" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,12" Text="Die Prüfungen nacheinander durchgehen. Gesammelte Dateien werden nur vorgemerkt und erst im letzten Schritt hochgeladen. Schritte für nicht installierte Rollen entfallen."/>
                <!--SCHRITTE-->
            </StackPanel>
        </Border>

        <!-- Schritt 1 -->
        <Border x:Name="PnlAsCheck" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Schritt 1: Server prüfen" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,10" Text="Prüft Administratorrechte, die installierten Rollen (DNS, DHCP, Druckserver, Domänencontroller), die Verbindung zum Tauschordner und den freien Platz. Ändert nichts."/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnAsCheck" Content="Server prüfen" Style="{DynamicResource PrimaryButton}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtAsCheckState" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"/>
                </StackPanel>
                <StackPanel x:Name="PnlAsCheckRows" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Schritt DNS -->
        <Border x:Name="PnlAsDns" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Schritt: DNS" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,10" Text="Liest den Status des DNS-Loggings. Ist es aus, lässt es sich einschalten (die Logs später sammeln). Ist es an und gibt es Logs, werden sie gesammelt und vorgemerkt."/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnAsDnsRead" Content="Status lesen" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtAsDnsState" Text="Noch nicht gelesen" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                </StackPanel>
                <TextBlock x:Name="TxtAsDnsDetail" Style="{DynamicResource Hint}" Margin="0,8,0,0"/>

                <StackPanel x:Name="BoxAsDnsOff" Margin="0,14,0,0" Visibility="Collapsed">
                    <Border Style="{DynamicResource InfoBand}" Margin="0,0,0,12">
                        <TextBlock Style="{DynamicResource BandText}" Text="Das Logging ist aus. Schalten Sie es ein und sammeln Sie die Logs später, nach einigen Tagen Betrieb. Sonst enthält die Datei zu wenig für die Auswertung. Vor der Änderung folgt eine Prüfung und eine Bestätigung."/>
                    </Border>
                    <TextBlock Text="Pfad der Logdatei" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TxtAsDnsPath" Padding="8,6" Margin="0,4,0,10" AutomationProperties.Name="Pfad der DNS-Logdatei"/>
                    <TextBlock Text="Maximale Größe in MB (1 MB = 1.000.000 Byte)" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TxtAsDnsMax" Padding="8,6" Margin="0,4,0,12" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Maximale Größe der Logdatei in MB"/>
                    <Button x:Name="BtnAsDnsEnable" Content="Logging einschalten …" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel x:Name="BoxAsDnsOn" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtAsDnsLogInfo" Style="{DynamicResource Hint}" Margin="0,0,0,10"/>
                    <Button x:Name="BtnAsDnsCollect" Content="Logs sammeln und vormerken" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"/>
                    <ProgressBar x:Name="PrgAsDns" Style="{DynamicResource ThinProgress}" Margin="0,10,0,0" IsIndeterminate="False" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock x:Name="TxtAsDnsResult" Style="{DynamicResource Hint}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Schritt DHCP -->
        <Border x:Name="PnlAsDhcp" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Schritt: DHCP" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,10" Text="Exportiert Bereiche, Optionen, Reservierungen (und Leases) und legt eine Zusammenfassung dazu. Beides kommt als ZIP in die Vormerkliste. Der Export ändert nichts am DHCP-Server."/>
                <CheckBox x:Name="ChkAsDhcpNoLeases" Margin="0,0,0,10"><TextBlock TextWrapping="Wrap" Text="Ohne Leases exportieren (keine MAC-Adressen und Hostnamen der Geräte, personenbezogene Daten). Standard: mit Leases." Foreground="{DynamicResource Text}"/></CheckBox>
                <Button x:Name="BtnAsDhcp" Content="Exportieren und vormerken" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"/>
                <TextBlock x:Name="TxtAsDhcpResult" Style="{DynamicResource Hint}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Schritt Print -->
        <Border x:Name="PnlAsPrint" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Schritt: Druckserver" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,10" Text="Erstellt die Inventur (Drucker, Treiber, Ports) und den Export mit PrintBrm. Ist das Druckprotokoll an, lassen sich zusätzlich die Zugriffe sammeln. Alles wird vorgemerkt."/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnAsPrintStatus" Content="Druckprotokoll prüfen" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtAsPrintLog" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="BtnAsPrintExport" Content="Inventur und Export erstellen und vormerken" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="Tage" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Text}"/>
                    <TextBox x:Name="TxtAsPrintDays" Width="60" Padding="8,6" Margin="0,0,12,0" AutomationProperties.Name="Anzahl Tage für die Zugriffe"/>
                    <Button x:Name="BtnAsPrintCollect" Content="Zugriffe sammeln und vormerken"/>
                </StackPanel>
                <TextBlock x:Name="TxtAsPrintResult" Style="{DynamicResource Hint}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Schritt AD -->
        <Border x:Name="PnlAsAd" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Schritt: Active Directory" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,10" Text="Erstellt den Übersichtsbericht (Gesamtstruktur, Funktionsebenen, Schema, Domänencontroller, FSMO-Rollen, Replikation, dcdiag). Nur lesend. Er wird vorgemerkt."/>
                <Button x:Name="BtnAsAd" Content="Übersichtsbericht erstellen und vormerken" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"/>
                <TextBlock x:Name="TxtAsAdResult" Style="{DynamicResource Hint}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Letzter Schritt: hochladen -->
        <Border x:Name="PnlAsUpload" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Letzter Schritt: Ergebnisse hochladen" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,12" Text="Alle vorgemerkten Dateien mit Größe und SHA256. Mit dem Haken legen Sie fest, was hochgeladen wird. Große Dateien gehen in Teilen hoch."/>
                <TextBlock x:Name="TxtAsFilesEmpty" Style="{DynamicResource Hint}" Text="Noch nichts vorgemerkt. In den Schritten davor sammeln."/>
                <StackPanel x:Name="PnlAsFiles"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="BtnAsUpload" Content="Ausgewählte hochladen" Style="{DynamicResource PrimaryButton}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtAsUploadState" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                </StackPanel>
                <Border x:Name="BoxAsSummary" Style="{DynamicResource InfoBand}" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Zusammenfassung" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtAsSummary" Style="{DynamicResource BandText}" FontFamily="{DynamicResource MonoFont}" FontSize="12"/>
                        <TextBlock Style="{DynamicResource Hint}" Margin="0,8,0,8" Text="Die Prüfsummen brauchen Sie am neuen Server beim Import von DHCP und Druckserver. Bei Print heißen die Zeilen Export und Inventur."/>
                        <Button x:Name="BtnAsCopySha" Content="Prüfsummen kopieren" HorizontalAlignment="Left" IsEnabled="False"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Weitere Datei hochladen" Style="{DynamicResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnUpload" Content="Datei wählen und hochladen …" IsEnabled="False" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtProgress" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"/>
                        </StackPanel>
                        <ProgressBar x:Name="PrgUpload" Style="{DynamicResource ThinProgress}" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Weiter und zurueck -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="BtnAsBack" Content="Zurück" HorizontalAlignment="Left" IsEnabled="False"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnAsSkip" Content="Überspringen" Margin="0,0,10,0"/>
                <Button x:Name="BtnAsNext" Content="Weiter" Style="{DynamicResource PrimaryButton}"/>
            </StackPanel>
        </Grid>

        <!--PROTOKOLL-->
    </StackPanel>
</ScrollViewer>
