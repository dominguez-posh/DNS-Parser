<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource PageScroll}">
    <!-- Bereich DHCP im Server-Fenster (Phase 4). Logik: server\SmDhcpServer.ps1 -->
    <StackPanel Margin="40,32,40,28" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="DHCP" Style="{DynamicResource PageTitle}"/>
        <TextBlock Style="{DynamicResource Subtitle}" Text="Alter Server: exportieren und Bereiche später deaktivieren. Neuer Server: Export holen, importieren, autorisieren und den Stand zum Vergleich hochladen. Jede Änderung hat eine Vorprüfung, eine Bestätigung und eine Protokollzeile."/>

        <Border Style="{DynamicResource CardBox}" Margin="0,20,0,0" Background="{DynamicResource Card}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Vorprüfung" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,8" TextWrapping="Wrap" Text="Prüft Rolle und Modul DhcpServer, Administrator und die Autorisierung in AD. Ändert nichts."/>
                <Button x:Name="BtnDhcpCheck" Content="Vorprüfung" Tag="&#xE72C;" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"/>
                <TextBox x:Name="TxtDhcpCheck" Style="{DynamicResource CodeBox}" Margin="0,10,0,0" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" FontSize="12"/>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Alter Server: Export" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,10" TextWrapping="Wrap" Text="Exportiert Bereiche, Optionen, Reservierungen und Leases (Export-DhcpServer -Leases) und legt eine Zusammenfassung dazu (Bereiche v4 und v6, Optionen, Reservierungen, Ausschlüsse, Leases, Failover, Richtlinien, Filter, DNS-Update, Bindungen). Beides kommt als ZIP in den Tauschordner. Die SHA256 mit &quot;SHA256 kopieren&quot; holen und am neuen Server einfügen."/>
                <CheckBox x:Name="ChkDhcpNoLeases" Margin="0,0,0,10"><TextBlock TextWrapping="Wrap" Text="Ohne Leases exportieren (keine MAC-Adressen und Hostnamen der Geräte, personenbezogene Daten). Standard: mit Leases." Foreground="{DynamicResource Text}"/></CheckBox>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnDhcpExport" Content="Exportieren und hochladen" Tag="&#xE898;" Style="{DynamicResource PrimaryButton}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtDhcpExport" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"/>
                </StackPanel>
                <ProgressBar x:Name="PrgDhcpExport" Style="{DynamicResource ThinProgress}" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
                <Border Style="{DynamicResource Chip}" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SHA256" Style="{DynamicResource ChipLabel}"/>
                        <TextBlock x:Name="TxtDhcpExportSha" Style="{DynamicResource ChipValue}"/>
                        <Button x:Name="BtnDhcpCopySha" Content="&#xE8C8;" Style="{DynamicResource ChipIconButton}" IsEnabled="False" ToolTip="SHA256 kopieren (vollständig), am neuen Server einfügen" AutomationProperties.Name="SHA256 kopieren"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Neuer Server: Export holen und importieren" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,10" TextWrapping="Wrap" Text="1. Exporte suchen, auswählen, herunterladen. 2. Die vollständige SHA256 vom alten Server einfügen. 3. Bereiche wählen und importieren."/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnDhcpFind" Content="Exporte im Tauschordner suchen" Tag="&#xE721;" Margin="0,0,10,0"/>
                    <Button x:Name="BtnDhcpDownload" Content="Herunterladen" IsEnabled="False"/>
                </StackPanel>
                <ListBox x:Name="LstDhcpExports" Style="{DynamicResource PlainList}" MaxHeight="100" Margin="0,8,0,0" AutomationProperties.Name="DHCP-Exporte im Tauschordner">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="8,4" Foreground="{DynamicResource Text}"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="TxtDhcpDlSha" Style="{DynamicResource Hint}" Margin="0,10,0,0"/>
                <TextBlock Text="SHA256 vom alten Server (dort mit dem Kopier-Symbol holen und hier einfügen)" Style="{DynamicResource SmallLabel}" Margin="0,12,0,2" TextWrapping="Wrap"/>
                <TextBox x:Name="TxtDhcpShaIn" Style="{DynamicResource HashInput}" IsEnabled="False" AutomationProperties.Name="SHA256 vom alten Server"/>
                <TextBlock x:Name="TxtDhcpShaState" Style="{DynamicResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <Button x:Name="BtnDhcpOpen" Content="Export prüfen und Bereiche laden" IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,0"/>

                <StackPanel x:Name="BoxDhcpImport" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtDhcpInfo" Style="{DynamicResource Hint}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <RadioButton x:Name="RdoDhcpAll" GroupName="DhcpScope" IsChecked="True" Margin="0,0,20,0"><TextBlock Text="Alles importieren" Foreground="{DynamicResource Text}"/></RadioButton>
                        <RadioButton x:Name="RdoDhcpSel" GroupName="DhcpScope"><TextBlock Text="Nur ausgewählte Bereiche" Foreground="{DynamicResource Text}"/></RadioButton>
                    </StackPanel>
                    <ListBox x:Name="LstDhcpScopes" Style="{DynamicResource PlainList}" SelectionMode="Extended" MaxHeight="160" Margin="0,8,0,0" AutomationProperties.Name="Bereiche im Export">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="8,4" Foreground="{DynamicResource Text}"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <CheckBox x:Name="ChkDhcpLeases" IsChecked="True" Margin="0,10,0,0"><TextBlock Text="Leases mit importieren" Foreground="{DynamicResource Text}"/></CheckBox>
                    <Button x:Name="BtnDhcpImport" Content="Importieren …" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    <TextBlock x:Name="TxtDhcpImport" Style="{DynamicResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Neuer Server: autorisieren und Stand hochladen" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,10" TextWrapping="Wrap" Text="Erst nach dem Import. Autorisierung in AD (Add-DhcpServerInDC) mit Bestätigung. Danach den Stand des neuen Servers hochladen: Das Berater-Tool vergleicht ihn mit dem Export."/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnDhcpAuth" Content="In AD autorisieren …" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtDhcpAuth" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="ChkDhcpAfterNoLeases" Margin="0,10,0,0"><TextBlock TextWrapping="Wrap" Text="Ohne Lease-Liste hochladen (keine MAC-Adressen; verglichen wird dann nur die Anzahl der Leases)" Foreground="{DynamicResource Text}"/></CheckBox>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnDhcpAfter" Content="Stand des neuen Servers hochladen" Tag="&#xE898;" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtDhcpAfter" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Alter Server: Bereiche deaktivieren" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,10" TextWrapping="Wrap" Text="Eigener Schritt, erst wenn der neue Server die Bereiche übernommen hat und autorisiert ist. Setzt die gewählten Bereiche auf InActive; zurück geht es durch erneutes Aktivieren. Bereiche in einer Failover-Beziehung werden gemeldet."/>
                <Button x:Name="BtnDhcpOldList" Content="Bereiche dieses Servers lesen" HorizontalAlignment="Left"/>
                <ListBox x:Name="LstDhcpOldScopes" Style="{DynamicResource PlainList}" SelectionMode="Extended" MaxHeight="160" Margin="0,8,0,0" AutomationProperties.Name="Bereiche dieses Servers">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="8,4" Foreground="{DynamicResource Text}"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="BtnDhcpDeactivate" Content="Gewählte Bereiche deaktivieren …" Style="{DynamicResource DangerGhost}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</ScrollViewer>
