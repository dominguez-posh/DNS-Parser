<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="40,28,40,20">
    <Grid.Resources>
        <!-- Tabelle im Look des Themes (hell und dunkel): Farben nur über DynamicResource -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtle}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
        <TextBlock Text="DNS-Auswertung" Style="{DynamicResource PageTitle}"/>
        <TextBlock Style="{DynamicResource Subtitle}" Text="Schwerpunkt: Welche Clients fragen noch diesen DNS-Server oder Domänencontroller an? Anfragen anderer DNS-Server sind markiert."/>
    </StackPanel>

    <Border Grid.Row="1" Style="{DynamicResource CardBox}" Margin="0,14,0,0" Background="{DynamicResource Card}" Padding="16,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnDnsFind" Content="ZIPs im Tauschordner suchen" Tag="&#xE721;" Margin="0,0,10,0"/>
                <Button x:Name="BtnDnsLoad" Content="Auswählen und auswerten" Style="{DynamicResource PrimaryButton}" IsEnabled="False" Margin="0,0,10,0"/>
                <Button x:Name="BtnDnsOpen" Content="Datei öffnen …" Tag="&#xE8E5;" Margin="0,0,10,0"/>
                <Button x:Name="BtnDnsCancel" Content="Abbrechen" Style="{DynamicResource GhostButton}" IsEnabled="False"/>
            </StackPanel>
            <ListBox x:Name="LstDnsZips" Style="{DynamicResource PlainList}" SelectionMode="Extended" MaxHeight="76" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.Name="DNS-ZIPs im Tauschordner">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="8,4" Foreground="{DynamicResource Text}"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Datumsformat" VerticalAlignment="Center" Margin="0,0,8,0" Style="{DynamicResource SmallLabel}"/>
                <ComboBox x:Name="CmbDnsDate" SelectedIndex="0" Margin="0,0,20,0" AutomationProperties.Name="Datumsformat">
                    <ComboBoxItem Tag="" Content="automatisch (aus Metadatei, sonst erkannt)"/>
                    <ComboBoxItem Tag="DMY" Content="dd.MM.yyyy (Tag zuerst)"/>
                    <ComboBoxItem Tag="MDY" Content="M/d/yyyy (Monat zuerst)"/>
                    <ComboBoxItem Tag="YMD" Content="yyyy-MM-dd"/>
                </ComboBox>
                <CheckBox x:Name="ChkDnsReverse" VerticalAlignment="Center"><TextBlock Text="Namen der Clients auflösen (Reverse, optional)" Foreground="{DynamicResource Text}"/></CheckBox>
            </StackPanel>
            <ProgressBar x:Name="PrgDnsLoad" Style="{DynamicResource ThinProgress}" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtDnsLoad" Style="{DynamicResource Hint}" Margin="0,6,0,0"/>
            <TextBlock x:Name="TxtDnsPeriod" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>

    <DockPanel Grid.Row="2" Margin="0,12,0,8" LastChildFill="True">
        <Button x:Name="BtnDnsExport" DockPanel.Dock="Right" Content="Als CSV exportieren" Tag="&#xE78C;" IsEnabled="False" Margin="10,0,0,0"/>
        <Button x:Name="BtnDnsApply" DockPanel.Dock="Right" Content="Filtern" IsEnabled="False" Margin="10,0,0,0"/>
        <ComboBox x:Name="CmbDnsView" DockPanel.Dock="Left" SelectedIndex="0" IsEnabled="False" Margin="0,0,10,0" AutomationProperties.Name="Ansicht">
            <ComboBoxItem Tag="Clients" Content="Clients (wer fragt noch an)"/>
            <ComboBoxItem Tag="DnsServer" Content="Andere DNS-Server"/>
            <ComboBoxItem Tag="Fehler" Content="Fehlerhafte Antworten"/>
            <ComboBoxItem Tag="Namen" Content="Namen"/>
            <ComboBoxItem Tag="Zonen" Content="Zonen"/>
            <ComboBoxItem Tag="Typen" Content="Record-Typen"/>
            <ComboBoxItem Tag="Updates" Content="Updates und Notify"/>
            <ComboBoxItem Tag="Roh" Content="Rohdaten"/>
        </ComboBox>
        <TextBox x:Name="TxtDnsFilter" Padding="8,6" ToolTip="Filter: Begriffe mit Leerzeichen, alle müssen vorkommen (IP, Name, Typ, NXDOMAIN, Notify …)" AutomationProperties.Name="Filter"/>
    </DockPanel>

    <Grid Grid.Row="3">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGrid x:Name="GrdDns" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="{DynamicResource Card}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                  HorizontalGridLinesBrush="{DynamicResource Divider}" RowBackground="Transparent" FontSize="12" SelectionUnit="FullRow" MinHeight="120"
                  EnableRowVirtualization="True" AutomationProperties.Name="Auswertung"/>
        <TextBlock x:Name="TxtDnsCount" Grid.Row="1" Style="{DynamicResource Hint}" Margin="0,6,0,0"/>
    </Grid>
</Grid>
