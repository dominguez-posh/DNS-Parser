<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource PageScroll}">
    <!-- Seite "Print" im Server-Fenster (Phase 5). Logik: server\SmPrintServer.ps1 -->
    <StackPanel Margin="40,32,40,28" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="Print" Style="{DynamicResource PageTitle}"/>
        <TextBlock Style="{DynamicResource Subtitle}" Text="Drucker, Treiber, Ports und Freigaben mit PrintBrm exportieren und importieren, dazu eine Inventur und das Zugriffsprotokoll (Ereignis 307)."/>
        <TextBlock x:Name="TxtPrFolder" Style="{DynamicResource Hint}" Margin="0,6,0,0"/>

        <Border Style="{DynamicResource CardBox}" Margin="0,20,0,0" Background="{DynamicResource Card}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Dieser Server ist" Style="{DynamicResource CardTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <RadioButton x:Name="RbPrOld" Content="der alte Server (Quelle)" GroupName="PrRole" Margin="0,0,24,0"/>
                    <RadioButton x:Name="RbPrNew" Content="der neue Server (Ziel)" GroupName="PrRole"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="BoxPrOld" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Export (alter Server)" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,8" TextWrapping="Wrap" Text="PrintBrm -B sichert alle Drucker, Treiber, Ports, Warteschlangen und Freigaben in eine Datei. Zusätzlich entsteht eine Inventur (JSON) mit Treiberversion, Architektur, Standort, Kommentar und Veröffentlichung im AD."/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnPrCheckExp" Content="Vorprüfung" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPrExport" Content="Export und Inventur erstellen" Style="{DynamicResource PrimaryButton}"/>
                </StackPanel>
                <TextBlock Text="SHA256 des Exports (am neuen Server vollständig einfügen)" Style="{DynamicResource SmallLabel}" Margin="0,12,0,2"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TxtPrExpSha" Style="{DynamicResource SelectableText}" Width="560" Height="44" AcceptsReturn="True" FontFamily="{DynamicResource MonoFont}" FontSize="12" Margin="0,0,8,0" AutomationProperties.Name="SHA256 des Exports"/>
                    <Button x:Name="BtnPrShaCopy" Content="Beide SHA256 kopieren"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="BoxPrNew" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Import (neuer Server)" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,8" TextWrapping="Wrap" Text="Export aus dem Tauschordner wählen, Prüfsumme mit der des alten Servers vergleichen, Vorprüfung, Bestätigung. Die Inventur des alten Servers ist für die Prüfung auf Namenskonflikte gedacht."/>
                <Button x:Name="BtnPrListShare" Content="Dateien im Tauschordner anzeigen" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <TextBlock Text="Exportdatei" Style="{DynamicResource SmallLabel}"/>
                <ComboBox x:Name="CmbPrExportFile" MinWidth="360" HorizontalAlignment="Left" AutomationProperties.Name="Exportdatei im Tauschordner"/>
                <TextBlock Text="Inventur des alten Servers (optional)" Style="{DynamicResource SmallLabel}" Margin="0,8,0,2"/>
                <ComboBox x:Name="CmbPrInvFile" MinWidth="360" HorizontalAlignment="Left" AutomationProperties.Name="Inventur des alten Servers"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnPrDownload" Content="Herunterladen" Margin="0,0,12,0"/>
                </StackPanel>
                <TextBlock Text="SHA256 des Exports vom alten Server (vollständig einfügen)" Style="{DynamicResource SmallLabel}" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtPrShaIn" Padding="8,6" FontFamily="{DynamicResource MonoFont}" FontSize="12" AutomationProperties.Name="SHA256 des Exports vom alten Server"/>
                <TextBlock Text="SHA256 der Inventur vom alten Server (nur bei gewählter Inventur)" Style="{DynamicResource SmallLabel}" Margin="0,8,0,2"/>
                <TextBox x:Name="TxtPrInvShaIn" Padding="8,6" FontFamily="{DynamicResource MonoFont}" FontSize="12" AutomationProperties.Name="SHA256 der Inventur vom alten Server"/>
                <TextBlock x:Name="TxtPrSha" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0" Text="Noch nichts heruntergeladen."/>
                <CheckBox x:Name="ChkPrShares" Content="Freigaben übernehmen" IsChecked="True" Margin="0,10,0,0"/>
                <CheckBox x:Name="ChkPrPublish" Content="Im Active Directory veröffentlichen (wie auf dem alten Server)" Margin="0,6,0,0"/>
                <CheckBox x:Name="ChkPrForce" Content="Vorhandene Drucker gleichen Namens überschreiben (-O FORCE)" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="BtnPrCheckImp" Content="Vorprüfung" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPrImport" Content="Importieren …" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPrInventory" Content="Inventur erstellen"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Zugriffe (Druckprotokoll)" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,8" TextWrapping="Wrap" Text="Das Protokoll Microsoft-Windows-PrintService/Operational muss laufen, damit Ereignis 307 (Druckauftrag) entsteht. Der alte Zustand wird gesichert; Ausschalten stellt ihn wieder her. Die Daten enthalten Benutzer- und Rechnernamen."/>
                <TextBlock x:Name="TxtPrLogStatus" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Größe (MB)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtPrLogSize" Width="70" Padding="6,4" Margin="0,0,12,0" AutomationProperties.Name="Größe des Protokolls in MB"/>
                    <Button x:Name="BtnPrLogOn" Content="Druckprotokoll einschalten" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPrLogOff" Content="Ausschalten (alter Zustand)" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPrLogRefresh" Content="Status"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Letzte Tage" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtPrDays" Width="70" Padding="6,4" Margin="0,0,12,0" AutomationProperties.Name="Tage zurück"/>
                    <Button x:Name="BtnPrCollect" Content="Zugriffe sammeln" Style="{DynamicResource PrimaryButton}"/>
                </StackPanel>
                <TextBlock Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,10,0,0" Text="Datenschutz: Benutzer- und Rechnernamen aus Ereignis 307 sind personenbezogene Daten."/>
                <CheckBox x:Name="ChkPrPseudo" Content="Benutzernamen pseudonymisieren (HMAC-SHA256 mit zufälligem Schlüssel)" Margin="0,8,0,0"/>
                <CheckBox x:Name="ChkPrPseudoClient" Content="Rechnernamen auch pseudonymisieren" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Schlüssel" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtPrKey" Width="520" Padding="6,4" FontFamily="{DynamicResource MonoFont}" FontSize="12" Margin="0,0,8,0" AutomationProperties.Name="Schlüssel für Pseudonyme, 64 Hexzeichen"/>
                    <Button x:Name="BtnPrKeyNew" Content="Neuer Schlüssel" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPrKeyCopy" Content="Schlüssel kopieren"/>
                </StackPanel>
                <TextBlock Text="Zufällig erzeugt, steht nie in einer Datei oder im Tauschordner. Für alle Sammlungen und Server des Projekts denselben verwenden und sicher aufbewahren." Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Dateien hochladen" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,8" Text="Dateien aus dem Sicherungsordner in den Tauschordner (große in Teilen). Die SHA256 wird angezeigt."/>
                <ListBox x:Name="LstPrLocal" Style="{DynamicResource PlainList}" MaxHeight="160" AutomationProperties.Name="Dateien im Sicherungsordner"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnPrUpload" Content="Hochladen" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPrLocalRefresh" Content="Liste aktualisieren" Margin="0,0,12,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtPrUploadState" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="12"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Ergebnis der Vorprüfung und Aktion" Style="{DynamicResource FieldLabel}" Margin="0,20,0,6"/>
        <TextBox x:Name="TxtPrCheck" Style="{DynamicResource SelectableText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="200" VerticalScrollBarVisibility="Auto" FontSize="12"/>
    </StackPanel>
</ScrollViewer>
